# GEMINI_API_KEY: Required for Gemini AI API calls (product recommendations & smart search).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# STRIPE_SECRET_KEY: Optional Stripe secret key for card payment processing.
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Optional Stripe webhook signing secret for payment webhook verification.
STRIPE_WEBHOOK_SECRET=

# JAZZCASH_MERCHANT_ID: Optional JazzCash Merchant ID for Pakistan mobile wallet adapter.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# EASYPAISA_STORE_ID: Optional Easypaisa Store ID for Pakistan mobile wallet adapter.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# RESEND_API_KEY: Optional Resend API key for transactional order confirmation emails.
RESEND_API_KEY=
