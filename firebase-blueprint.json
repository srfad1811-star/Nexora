{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private customer profile, contact information, and saved addresses.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "addresses": { "type": "array" },
        "isBlocked": { "type": "boolean" },
        "customerGroup": { "type": "string", "enum": ["standard", "vip", "wholesale"] },
        "loyaltyPoints": { "type": "integer" },
        "totalSpent": { "type": "number" },
        "orderCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "isBlocked", "createdAt", "updatedAt"]
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Authorized staff account with server-enforced RBAC role and permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "store_manager", "product_manager", "order_manager", "support_agent"] },
        "permissions": { "type": "array" },
        "active": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "active", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product catalog category supporting hierarchy and SEO metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 500 },
        "parentId": { "type": "string", "maxLength": 128 },
        "sortOrder": { "type": "integer" },
        "active": { "type": "boolean" },
        "seoTitle": { "type": "string", "maxLength": 140 },
        "seoDescription": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "sortOrder", "active", "createdAt"]
    },
    "Brand": {
      "title": "Brand",
      "description": "Catalog brand partner with logo and featured flag.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-z0-9\\-]+$" },
        "description": { "type": "string", "maxLength": 500 },
        "logo": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "featured", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Catalog SKU item with pricing, variants, inventory, and SEO fields.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[a-z0-9\\-]+$" },
        "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
        "barcode": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 4000 },
        "shortDescription": { "type": "string", "maxLength": 300 },
        "categoryId": { "type": "string", "maxLength": 128 },
        "categoryName": { "type": "string", "maxLength": 100 },
        "subcategory": { "type": "string", "maxLength": 100 },
        "brandId": { "type": "string", "maxLength": 128 },
        "brandName": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "integer" },
        "lowStockThreshold": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "draft", "pending", "scheduled", "archived"] },
        "featured": { "type": "boolean" },
        "trending": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "images": { "type": "array" },
        "variants": { "type": "array" },
        "specifications": { "type": "array" },
        "ratingAvg": { "type": "number" },
        "ratingCount": { "type": "integer" },
        "salesCount": { "type": "integer" },
        "seoTitle": { "type": "string", "maxLength": 140 },
        "seoDescription": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "sku", "categoryId", "brandId", "price", "stock", "status", "createdAt", "updatedAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Authenticated user's persistent shopping cart.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "items": { "type": "array" },
        "couponCode": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "items", "updatedAt"]
    },
    "Wishlist": {
      "title": "Wishlist",
      "description": "Authenticated user's saved wishlist product IDs.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "productIds", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with line items, payment metadata, shipping address, and audit trail.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discountAmount": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 40 },
        "shippingFee": { "type": "number" },
        "codFee": { "type": "number" },
        "taxAmount": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "paymentMethod": { "type": "string", "enum": ["stripe", "cod", "bank_transfer", "jazzcash", "easypaisa"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "refunded", "awaiting_verification"] },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "packed", "shipped", "delivered", "cancelled", "refunded"] },
        "shippingAddress": { "type": "object" },
        "deliveryMethod": { "type": "string", "maxLength": 80 },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "deliveryPartner": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 500 },
        "internalNotes": { "type": "string", "maxLength": 1000 },
        "statusHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "userId", "customerEmail", "customerName", "items", "subtotal", "total", "paymentMethod", "paymentStatus", "status", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review with rating and moderation status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "integer" },
        "title": { "type": "string", "maxLength": 140 },
        "comment": { "type": "string", "maxLength": 1500 },
        "verifiedPurchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment", "status", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code and usage restrictions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 2, "maxLength": 40 },
        "type": { "type": "string", "enum": ["percentage", "fixed", "free_shipping"] },
        "value": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "usageLimit": { "type": "integer" },
        "usedCount": { "type": "integer" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "type", "value", "active", "createdAt"]
    },
    "ReturnRequest": {
      "title": "ReturnRequest",
      "description": "Customer return or refund request tied to an order.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderId": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 40 },
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "reason": { "type": "string", "maxLength": 600 },
        "status": { "type": "string", "enum": ["requested", "approved", "rejected", "refunded"] },
        "adminNotes": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderId", "orderNumber", "userId", "amount", "reason", "status", "createdAt", "updatedAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support inquiry thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "userName": { "type": "string", "maxLength": 120 },
        "subject": { "type": "string", "maxLength": 180 },
        "category": { "type": "string", "maxLength": 60 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "subject", "status", "messages", "createdAt", "updatedAt"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Audit log of stock adjustments and order deductions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128 },
        "productTitle": { "type": "string", "maxLength": 180 },
        "sku": { "type": "string", "maxLength": 64 },
        "delta": { "type": "integer" },
        "previousStock": { "type": "integer" },
        "newStock": { "type": "integer" },
        "reason": { "type": "string", "maxLength": 200 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "sku", "delta", "previousStock", "newStock", "reason", "createdAt"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Vendor supplier record for inventory replenishment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 140 },
        "contactName": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 40 },
        "leadTimeDays": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "createdAt"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Supplier purchase order for inventory intake.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "poNumber": { "type": "string", "maxLength": 40 },
        "supplierId": { "type": "string", "maxLength": 128 },
        "supplierName": { "type": "string", "maxLength": 140 },
        "items": { "type": "array" },
        "totalCost": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "ordered", "received", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "poNumber", "supplierId", "items", "totalCost", "status", "createdAt"]
    },
    "CmsConfig": {
      "title": "CmsConfig",
      "description": "Storefront CMS configuration, shipping zones, payment toggles, and static pages.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "data", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable admin audit log entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 200 },
        "actorRole": { "type": "string", "maxLength": 60 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 60 },
        "entityId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "entityType", "createdAt"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Customer email newsletter subscription.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User or admin notification record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientUid", "title", "message", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profiles and saved addresses"
    },
    "/staff/{uid}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Staff accounts and RBAC role assignments"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Storefront categories"
    },
    "/brands/{brandId}": {
      "schema": { "$ref": "#/entities/Brand" },
      "description": "Storefront brands"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Storefront product catalog"
    },
    "/carts/{uid}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Per-user persistent shopping carts"
    },
    "/wishlists/{uid}": {
      "schema": { "$ref": "#/entities/Wishlist" },
      "description": "Per-user wishlists"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and fulfillment state"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer product reviews"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount coupons"
    },
    "/returnRequests/{refundId}": {
      "schema": { "$ref": "#/entities/ReturnRequest" },
      "description": "Order return and refund requests"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer support threads"
    },
    "/inventoryMovements/{movementId}": {
      "schema": { "$ref": "#/entities/InventoryMovement" },
      "description": "Inventory stock ledger"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Inventory suppliers"
    },
    "/purchaseOrders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Supplier purchase orders"
    },
    "/cmsConfig/{docId}": {
      "schema": { "$ref": "#/entities/CmsConfig" },
      "description": "CMS storefront banners, shipping zones, payment toggles, and static pages"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable admin audit log"
    },
    "/newsletterSubscribers/{subId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter subscription records"
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User and admin notifications"
    }
  }
}
